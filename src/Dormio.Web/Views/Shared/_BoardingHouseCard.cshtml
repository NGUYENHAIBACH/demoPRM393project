@model BoardingHouseVm
<div class="card h-100 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <h5 class="card-title">@Model.Name</h5>
      <status-badge active="@Model.IsActive"></status-badge>
    </div>
    <p class="card-text text-muted mb-1">@Model.Address</p>
    <p class="card-text"><small>@Model.RoomCount room(s)</small></p>
  </div>
  <div class="card-footer bg-white d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit</a>
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Deactivate this boarding house?');">
      <button class="btn btn-sm btn-outline-danger">Deactivate</button>
    </form>
  </div>
</div>
